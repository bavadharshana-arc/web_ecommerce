{
  "name": "shopnexus-ecommerce",
  "version": "1.0.0",
  "description": "Production-grade Full-Stack E-Commerce Web Application",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "seed": "npm run prisma:seed --prefix backend",
    "test:backend": "npm test --prefix backend",
    "build:frontend": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "ecommerce",
    "react",
    "nodejs",
    "express",
    "prisma",
    "fullstack",
    "jwt",
    "tailwind"
  ],
  "author": "ShopNexus Team",
  "license": "MIT"
}
